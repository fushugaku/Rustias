<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key><string>English</string>
  <key>CFBundleExecutable</key><string>Rustias</string>
  <key>CFBundleIdentifier</key><string>io.github.fushugaku.rustias.au</string>
  <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
  <key>CFBundleName</key><string>Rustias</string>
  <key>CFBundlePackageType</key><string>BNDL</string>
  <key>CFBundleShortVersionString</key><string>@PROJECT_VERSION@</string>
  <key>CFBundleVersion</key><string>@PROJECT_VERSION@</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>AudioComponents</key>
  <array><dict>
    <key>name</key><string>Rustias: Rustias</string>
    <key>description</key><string>Rustias synthesizer</string>
    <key>factoryFunction</key><string>wrapAsAUV2_inst0Factory</string>
    <key>manufacturer</key><string>Fshg</string>
    <key>subtype</key><string>Rsts</string>
    <key>type</key><string>aumu</string>
    <key>version</key><integer>@RUSTIAS_AU_VERSION@</integer>
    <key>sandboxSafe</key><true/>
    <key>resourceUsage</key><dict>
      <key>network.client</key><true/>
      <key>temporary-exception.files.all.read-write</key><true/>
    </dict>
  </dict></array>
</dict>
</plist>
